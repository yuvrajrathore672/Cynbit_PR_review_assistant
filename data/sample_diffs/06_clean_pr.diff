+import pytest
+
+from app.utils.slug import slugify
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        ("Hello World", "hello-world"),
+        ("  Trim Me  ", "trim-me"),
+        ("Symbols!! & Spaces", "symbols-spaces"),
+        ("", ""),
+    ],
+)
+def test_slugify(raw, expected):
+    assert slugify(raw) == expected
