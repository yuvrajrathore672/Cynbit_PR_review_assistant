+from sqlalchemy import text
+
+
+def search_tasks(db, keyword: str):
+    query = f"SELECT id, title FROM tasks WHERE title LIKE '%{keyword}%'"
+    result = db.execute(text(query))
+    return [dict(row._mapping) for row in result]